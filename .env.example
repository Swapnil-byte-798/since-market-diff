# Postgres (docker compose up -d db)
DATABASE_URL=postgresql://since:since@localhost:5544/since

# Anthropic — used ONLY by the investigation agent.
# The product is fully functional without it (deterministic explanations).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# Market data ingestion (Yahoo, unofficial). Used by the one-shot ingest CLI only;
# never called on the demo path.
INGEST_UNIVERSE=nifty50
