# Postgres (docker compose up -d db)
DATABASE_URL=postgresql://since:since@localhost:5544/since

# LLM provider for the investigation agent. The product is fully functional
# without either key — changes are still detected, scored and explained by the
# deterministic engine, which is the default path rather than a degraded one.
#
# Gemini is preferred when both are present: its free tier means the
# investigation does not depend on a paid account.
#   Gemini key:    https://aistudio.google.com/apikey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Force one: gemini | anthropic | none. Omit to auto-select.
AGENT_PROVIDER=
# Override the model. Defaults: gemini-2.5-flash / claude-opus-5.
AGENT_MODEL=

# Market data ingestion. Used by the one-shot ingest CLI only; never called on
# the demo path.
#
# Yahoo's unofficial endpoint rate-limits by IP and has been observed blocking
# entire Indian mobile carrier ranges. Twelve Data is the reliable alternative:
# a free key allows 800 requests/day, and a full 51-symbol ingest needs ~102.
#   https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# auto (default) prefers twelvedata when a key is present, else yahoo.
# Force one with: npm run ingest -- --provider twelvedata|yahoo|synthetic
INGEST_PROVIDER=auto
