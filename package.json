{
  "name": "since",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "eval"],
  "engines": { "node": ">=20" },
  "scripts": {
    "db:up": "docker compose up -d db && node scripts/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:push": "npm run -w @since/db push",
    "db:studio": "npm run -w @since/db studio",
    "ingest": "npm run -w @since/ingest start",
    "eval": "npm run -w @since/eval start",
    "test": "npm run -w @since/core test",
    "typecheck": "tsc -b --pretty"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
